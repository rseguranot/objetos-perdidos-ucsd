rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function verifiedInstitutionalIdentity() {
      let token = request.auth.token;
      let mail = token.email;
      return request.auth != null
        && mail is string
        && token.email_verified == true
        && token.firebase.sign_in_provider in ['google.com', 'password']
        && mail.lower().matches('^[^@/]+@ucsd[.]edu[.]do$');
    }
    // QA ONLY: separate project, fixed identities and roles. Never deploy this file to the pilot.
    function qaEmail(value) { return value in ['administrador@demo.ucsd.invalid', 'decanato@demo.ucsd.invalid', 'registro@demo.ucsd.invalid']; }
    function qaExpectedRole(value) {
      return value == 'administrador@demo.ucsd.invalid' ? 'admin' : value == 'decanato@demo.ucsd.invalid' ? 'decanato' : 'registro';
    }
    function qaIdentity() {
      let users = {'80BNkhJEiFefiK766if5VVwdJI73': 'administrador@demo.ucsd.invalid', 'b3XvYdKiWNSRq9uYFyHyTGXBuMl1': 'decanato@demo.ucsd.invalid', 'LasetVY58jWJTesXY1By4w0zcc93': 'registro@demo.ucsd.invalid'};
      let token = request.auth.token;
      return request.auth != null && token.email is string
        && token.aud == 'ucsd-objetos-perdidos-pruebas'
        && token.firebase.sign_in_provider == 'password'
        && users.get(request.auth.uid, null) == token.email;
    }
    function verifiedStaffIdentity() { return qaEmail(request.auth.token.email) ? qaIdentity() : verifiedInstitutionalIdentity(); }
    function email() { return request.auth.token.email.lower(); }
    function staffRole() {
      // Read and validate one authorization record per operation. Missing records fail closed.
      let mail = email();
      let access = get(/databases/$(database)/documents/access/$(mail)).data;
      let role = access.role;
      let allowed = verifiedStaffIdentity()
        && access.active == true
        // Identity was verified above; the QA allowlist never contains this reserved address.
        && (role == 'developer' ? mail == 'rsegura20250554@ucsd.edu.do' : true)
        && (!qaEmail(mail) || role == qaExpectedRole(mail));
      return allowed ? role : '';
    }
    function hasRole(roles) { return staffRole() in roles; }
    function staff() { return hasRole(['developer', 'admin', 'decanato', 'registro']); }
    function custodian() { return hasRole(['developer', 'admin', 'decanato']); }
    function admin() { return hasRole(['developer', 'admin']); }
    function canReadInternal(d) {
      return custodian() || (hasRole(['registro']) && d.createdByUid == request.auth.uid);
    }
    function limitedQuery() { return request.query.limit != null && request.query.limit <= 500; }
    function countOrLimitedQuery() { return request.query.limit == null || limitedQuery(); }
    function text(value, maximum) { return value is string && value.trim() != '' && value.size() <= maximum; }
    function calendarDate(value) {
      let day = int(value[8:10]);
      // The native calendar rejects impossible dates, including non-leap February 29.
      return timestamp.date(int(value[0:4]), int(value[5:7]), day).day() == day;
    }
    function validDate(value) {
      return value is string && value.matches('^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$')
        && calendarDate(value);
    }
    function iso(value) {
      return value is string && value.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}[.][0-9]{3}Z$');
    }
    function classification(d) {
      let types = {
        'electronica': ['celular', 'laptop', 'tableta', 'audifonos', 'estuche', 'cargador', 'cable', 'calculadora', 'dispositivo', 'otro'],
        'documentos': ['identificacion', 'tarjeta', 'documento', 'sobre', 'carpeta', 'otro'],
        'llaves': ['llave', 'juego_llaves', 'llavero', 'otro'],
        'material_academico': ['cuaderno', 'libro', 'apuntes', 'carpeta', 'utiles', 'otro'],
        'bolsos_accesorios': ['mochila', 'bulto', 'bolso', 'lentes', 'botella', 'paraguas', 'reloj', 'joya', 'monedero', 'otro'],
        'ropa': ['chaqueta', 'gorra', 'camisa', 'calzado', 'prenda', 'otro'],
        'dinero': ['efectivo', 'otro'],
        'otros': ['otro']
      };
      return d.itemType in types.get(d.category, []);
    }
    function lastEventValid(d) {
      let history = d.history;
      let e = history[history.size() - 1];
      return e is map && e.keys().hasOnly(['id', 'at', 'actor', 'action'])
        && text(e.id, 80) && iso(e.at)
        && e.actor == email() && text(e.action, 300);
    }
    function historyAppended(before, after) {
      let oldHistory = before.history;
      let newHistory = after.history;
      return newHistory.size() == oldHistory.size() + 1
        && newHistory == oldHistory.concat([newHistory[newHistory.size() - 1]]);
    }
    function deliveryValid(d) {
      let v = d.get('delivery', null);
      return (v == null && d.status in ['borrador', 'disponible', 'archivado'])
        || (v is map && v.keys().hasOnly(['recipient', 'proof', 'deliveredAt', 'identityType', 'photoEvidenceReference', 'evidenceId'])
          && text(v.recipient, 300) && text(v.proof, 2000) && iso(v.deliveredAt)
          && ((!('identityType' in v) && !('photoEvidenceReference' in v) && !('evidenceId' in v)) || deliveryEvidenceValid(v))
          && d.status in ['entregado', 'archivado']);
    }
    function deliveryEvidenceValid(v) {
      return v.keys().hasAll(['identityType'])
        && v.identityType in ['documento_identidad', 'carnet_estudiante']
        && (('evidenceId' in v && !('photoEvidenceReference' in v)
          && v.evidenceId is string && v.evidenceId.matches('^[a-zA-Z0-9_-]{20,80}$'))
          || (!('evidenceId' in v) && 'photoEvidenceReference' in v
            && text(v.photoEvidenceReference, 300)
            && v.photoEvidenceReference == v.photoEvidenceReference.trim()));
    }
    function dispositionValid(d) {
      return !('disposition' in d) || dispositionDetailsValid(d.disposition, d);
    }
    function dispositionDetailsValid(v, d) {
      let recipient = v.recipient;
      let reference = v.reference;
      let completedAt = v.completedAt;
      return v is map && v.keys().hasOnly(['kind', 'recipient', 'reference', 'completedAt'])
          && text(recipient, 300) && recipient == recipient.trim()
          && text(reference, 2000) && reference == reference.trim()
          // Firestore stores an authoritative server timestamp; the UI decodes it to ISO.
          && completedAt is timestamp
          && d.status == 'archivado' && d.received == true
          // itemValid already checked the receipt date and custody whenever received is true.
          && !('delivery' in d)
          && ((d.category == 'documentos' && v.kind == 'remision_documentos')
            || (!(d.category in ['documentos', 'dinero']) && v.kind == 'donacion'));
    }
    function dispositionDeadline(receivedDate) {
      // Receipt dates are local Santo Domingo dates (UTC-4); midnight is 04:00 UTC.
      let receiptMidnightUtc = timestamp.date(int(receivedDate[0:4]), int(receivedDate[5:7]), int(receivedDate[8:10]));
      return receiptMidnightUtc + duration.value(90, 'd') + duration.time(4, 0, 0, 0);
    }
    // Used only after itemValid has validated the complete new disposition.
    function newDisposition(before, after) {
      let deadline = dispositionDeadline(before.receivedDate);
      let completedAt = after.disposition.completedAt;
      // dispositionTransition checked absence/presence. itemValid requires received and no delivery.
      // The restricted diff preserves those validated fields and the receipt/custody information.
      return before.status in ['borrador', 'disponible', 'archivado']
        && completedAt == request.time && completedAt >= deadline
        && after.diff(before).affectedKeys().hasOnly(['status', 'disposition', 'dispositionDate', 'searchTerms', 'history', 'updatedByUid', 'updatedAt']);
    }
    function dispositionTransition(before, after) {
      // A completed disposition is final: it cannot be rewritten, removed or edited.
      return !('disposition' in before)
        && (!('disposition' in after) || newDisposition(before, after));
    }
    function itemValid(d, itemId) {
      let requiredFields = ['id', 'code', 'title', 'category', 'itemType', 'description', 'foundDate', 'foundLocation', 'receivedDate', 'custodyLocation', 'privateDetails', 'received', 'status', 'history', 'createdByUid', 'updatedByUid', 'updatedAt', 'buildingId', 'searchTerms', 'publicSearchTerms', 'deliveryDate', 'dispositionDate'];
      let receivedDate = d.receivedDate;
      let custodyLocation = d.custodyLocation;
      let privateDetails = d.privateDetails;
      let history = d.history;
      let status = d.status;
      let received = d.received;
      let foundDate = d.foundDate;
      let foundDateValid = validDate(foundDate);
      let receivedDateValid = receivedDate == '' ? false : receivedDate == foundDate ? foundDateValid : validDate(receivedDate);
      // Every required field is read directly below; a missing field fails closed.
      return d.keys().hasOnly(requiredFields.concat(['delivery', 'disposition']))
        && d.id == itemId && text(d.code, 80) && text(d.title, 160)
        && classification(d) && text(d.description, 2000)
        && foundDateValid && text(d.foundLocation, 300)
        && d.buildingId is string && d.buildingId.size() <= 150
        && d.searchTerms is list && d.searchTerms.size() <= 500
        && d.publicSearchTerms is list && d.publicSearchTerms.size() <= 500
        && d.deliveryDate is string && (d.deliveryDate == '' || d.deliveryDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'))
        && d.dispositionDate is string && (d.dispositionDate == '' || d.dispositionDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'))
        && (('delivery' in d) == (d.deliveryDate != ''))
        && (('disposition' in d) == (d.dispositionDate != ''))
        && receivedDate is string
        && (receivedDate == '' || (receivedDateValid && receivedDate >= foundDate))
        && custodyLocation is string && custodyLocation.size() <= 300
        && privateDetails is string && privateDetails.size() <= 4000
        && received is bool
        && (!received || (receivedDateValid && text(custodyLocation, 300)))
        && status in ['borrador', 'disponible', 'entregado', 'archivado']
        && (!(status in ['disponible', 'entregado']) || received)
        && history is list && history.size() > 0 && history.size() <= 1000
        && lastEventValid(d)
        // A disposition requires no delivery; validate only the applicable final record.
        && ('disposition' in d ? dispositionValid(d) : deliveryValid(d))
        && text(d.createdByUid, 128) && d.updatedByUid == request.auth.uid
        && d.updatedAt == request.time;
    }
    function projectionMatches(p, d) {
      // Map equality enforces both the exact public fields and their matching values.
      return p == {'id': d.id, 'code': d.code, 'title': d.title, 'category': d.category,
          'itemType': d.itemType, 'description': d.description, 'foundDate': d.foundDate,
          'foundLocation': d.foundLocation, 'status': 'disponible',
          'buildingId': d.buildingId, 'searchTerms': d.publicSearchTerms};
    }
    function publicMatches(p, d) {
      return projectionMatches(p, d) && d.status == 'disponible' && d.received == true
        && validDate(d.receivedDate) && d.receivedDate >= d.foundDate
        && text(d.custodyLocation, 300);
    }
    // Called only after itemValid: receipt, dates and custody have already been checked.
    function publicationCoherent(d, itemId) {
      let publicPath = /databases/$(database)/documents/publicItems/$(itemId);
      return d.status == 'disponible'
        ? existsAfter(publicPath) && projectionMatches(getAfter(publicPath).data, d)
        : !existsAfter(publicPath);
    }
    function registrationDraft(d) {
      return d.status == 'borrador' && d.received == false
        && d.receivedDate == '' && d.custodyLocation == '' && !('delivery' in d) && !('disposition' in d);
    }
    function validTransition(before, after) {
      return (before.status == 'borrador' && after.status in ['borrador', 'disponible', 'archivado'])
        || (before.status == 'disponible' && after.status in ['disponible', 'entregado', 'archivado'])
        || (before.status == 'entregado' && after.status == 'archivado'
          && after.diff(before).affectedKeys().hasOnly(['status', 'history', 'updatedByUid', 'updatedAt']))
        // dispositionTransition has already validated a new final disposition.
        || (before.status == 'archivado' && 'disposition' in after);
    }
    function deliveryTransition(before, after) {
      return (before.status == 'disponible' && after.status == 'entregado'
          // itemValid already validates values; new deliveries must also contain both evidence fields.
          && after.delivery.keys().hasAll(['identityType', 'photoEvidenceReference']))
        || after.get('delivery', null) == before.get('delivery', null);
    }
    function assignableAccess(targetEmail) {
      return admin() && targetEmail != 'rsegura20250554@ucsd.edu.do'
        && (targetEmail.matches('^[^@/]+@ucsd[.]edu[.]do$') || qaEmail(targetEmail)) && targetEmail == targetEmail.lower()
        && request.resource.data.keys().hasAll(['email', 'role', 'active', 'updatedByUid', 'updatedAt'])
        && request.resource.data.keys().hasOnly(['email', 'role', 'active', 'updatedByUid', 'updatedAt'])
        && request.resource.data.email == targetEmail
        && request.resource.data.role in ['admin', 'registro', 'decanato']
        && (!qaEmail(targetEmail) || request.resource.data.role == qaExpectedRole(targetEmail))
        && request.resource.data.active is bool
        && request.resource.data.updatedByUid == request.auth.uid
        && request.resource.data.updatedAt == request.time
        && (targetEmail != email() || (request.resource.data.role == 'admin' && request.resource.data.active == true));
    }
    function removableAccess(targetEmail) {
      return admin() && targetEmail != email()
        && targetEmail != 'rsegura20250554@ucsd.edu.do'
        && (targetEmail.matches('^[^@/]+@ucsd[.]edu[.]do$') || qaEmail(targetEmail))
        && resource.data.email == targetEmail && resource.data.role != 'developer'
        && (!qaEmail(targetEmail) || resource.data.role == qaExpectedRole(targetEmail));
    }
    function itemCreateAllowed(itemId) {
      let role = staffRole();
      let after = request.resource.data;
      return role in ['developer', 'admin', 'decanato', 'registro'] && itemValid(after, itemId)
        && after.createdByUid == request.auth.uid && after.status == 'borrador'
        && after.history.size() == 1 && !('delivery' in after) && !('disposition' in after)
        && (role in ['developer', 'admin', 'decanato'] || registrationDraft(after))
        && publicationCoherent(after, itemId);
    }
    function deliveryUpdateAllowed(before, after, itemId, role) {
      // Only the photo service commits new handovers through IAM.
      return false;
    }
    function archiveDeliveredAllowed(before, after, itemId, role) {
      // The delivered record was validated at handover. Archiving changes only
      // its state and appends an audit event; evidence remains immutable.
      return role in ['developer', 'admin', 'decanato']
        && before.status == 'entregado' && after.status == 'archivado'
        && after.diff(before).affectedKeys().hasOnly(['status', 'history', 'updatedByUid', 'updatedAt'])
        && after.updatedByUid == request.auth.uid && after.updatedAt == request.time
        && historyAppended(before, after) && after.history.size() <= 1000 && lastEventValid(after)
        && !existsAfter(/databases/$(database)/documents/publicItems/$(itemId));
    }
    function dispositionUpdateAllowed(before, after, itemId, role) {
      // The source record was validated on its previous write. A final destination
      // changes only its disposition, private search index, state and audit event.
      let v = after.disposition;
      return role in ['developer', 'admin', 'decanato']
        && before.status in ['borrador', 'disponible', 'archivado']
        && before.received == true && !('delivery' in before) && !('disposition' in before)
        && after.status == 'archivado'
        && after.diff(before).affectedKeys().hasOnly(['status', 'disposition', 'dispositionDate', 'searchTerms', 'history', 'updatedByUid', 'updatedAt'])
        && after.updatedByUid == request.auth.uid && after.updatedAt == request.time
        && historyAppended(before, after) && after.history.size() <= 1000 && lastEventValid(after)
        && v is map && v.keys().hasAll(['kind', 'recipient', 'reference', 'completedAt'])
        && v.keys().hasOnly(['kind', 'recipient', 'reference', 'completedAt'])
        && text(v.recipient, 300) && v.recipient == v.recipient.trim()
        && text(v.reference, 2000) && v.reference == v.reference.trim()
        && v.completedAt == request.time && v.completedAt >= dispositionDeadline(before.receivedDate)
        && ((before.category == 'documentos' && v.kind == 'remision_documentos')
          || (!(before.category in ['documentos', 'dinero']) && v.kind == 'donacion'))
        && after.searchTerms is list && after.searchTerms.size() <= 500
        && after.dispositionDate is string
        && after.dispositionDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && !existsAfter(/databases/$(database)/documents/publicItems/$(itemId));
    }
    function itemUpdateAllowed(itemId) {
      let role = staffRole();
      let before = resource.data;
      let after = request.resource.data;
      return role in ['developer', 'admin', 'decanato', 'registro']
        && (before.status == 'disponible' && after.status == 'entregado'
          ? deliveryUpdateAllowed(before, after, itemId, role)
          : before.status == 'entregado' && after.status == 'archivado'
          ? archiveDeliveredAllowed(before, after, itemId, role)
          : 'disposition' in after && !('disposition' in before)
          ? dispositionUpdateAllowed(before, after, itemId, role)
          : (itemValid(after, itemId)
        && after.createdByUid == before.createdByUid && after.code == before.code
        && historyAppended(before, after)
        // Final disposition already enforces archival, no delivery and the permitted prior states.
        && ('disposition' in after
          ? (role in ['developer', 'admin', 'decanato'] && dispositionTransition(before, after)
            && !existsAfter(/databases/$(database)/documents/publicItems/$(itemId)))
          : (deliveryTransition(before, after) && dispositionTransition(before, after)
            && ((role in ['developer', 'admin', 'decanato'] && validTransition(before, after))
              || (role == 'registro' && before.createdByUid == request.auth.uid
                && registrationDraft(before) && registrationDraft(after)))
            && publicationCoherent(after, itemId)))));
    }
    function publicDeleteAllowed(itemId) {
      let privatePath = /databases/$(database)/documents/privateItems/$(itemId);
      let before = get(privatePath).data;
      let after = getAfter(privatePath).data;
      // A changed server timestamp proves a private write in this same atomic request.
      // Its private rule requires a verified, active custodian for either terminal status.
      // A standalone delete cannot change the before/after timestamp and is denied.
      return request.auth != null && exists(privatePath) && existsAfter(privatePath)
        && before.get('updatedAt', null) != after.updatedAt
        && after.updatedByUid == request.auth.uid && after.updatedAt == request.time
        && after.status in ['entregado', 'archivado'];
    }
    match /access/{targetEmail} {
      // No auto-enrollment: a denied user can only inspect their own document.
      allow get: if verifiedStaffIdentity() && (targetEmail == email() || admin());
      allow list: if admin() && limitedQuery();
      // Developer cannot be granted, demoted or revoked by ANY app client, including Developer itself.
      allow create: if assignableAccess(targetEmail);
      allow update: if assignableAccess(targetEmail) && resource.data.role != 'developer';
      allow delete: if removableAccess(targetEmail);
    }
    match /privateItems/{itemId} {
      // Creation transactions need to verify that their generated ID is unused.
      allow get: if staff() && (!exists(/databases/$(database)/documents/privateItems/$(itemId))
        || canReadInternal(resource.data));
      // A registro query must include where('createdByUid', '==', auth.uid).
      allow list: if staff() && countOrLimitedQuery() && canReadInternal(resource.data);
      allow create: if itemCreateAllowed(itemId);
      allow update: if itemUpdateAllowed(itemId);
      allow delete: if false;
    }
    match /publicItems/{itemId} {
      allow get: if true;
      allow list: if countOrLimitedQuery();
      allow create, update: if custodian()
        && existsAfter(/databases/$(database)/documents/privateItems/$(itemId))
        && publicMatches(request.resource.data, getAfter(/databases/$(database)/documents/privateItems/$(itemId)).data);
      allow delete: if publicDeleteAllowed(itemId);
    }
    match /deliveryEvidence/{evidenceId} {
      allow get: if staff();
      allow list: if staff() && request.query.limit != null && request.query.limit <= 25;
      allow write: if false;
    }
    match /evidenceOperations/{operationId} { allow read, write: if false; }
    match /{document=**} { allow read, write: if false; }
  }
}
